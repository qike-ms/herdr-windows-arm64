-# Puts Microsoft's ConPTY beside herdr-core.exe: <Dest>\conpty\conpty.dll and
-# <Dest>\conpty\x64\OpenConsole.exe. Windows' own ConPTY swallows the answers
-# hc gives programs (7501, DA), so hc ships this one. Pinned and checked.
-param([Parameter(Mandatory)][string]$Dest)
+# Puts Microsoft's ConPTY beside herdr-core.exe: <Dest>\conpty\conpty.dll
+# for hc's CPU (-Arch x64 or arm64; this machine's by default), and both
+# <Dest>\conpty\x64\OpenConsole.exe and <Dest>\conpty\arm64\OpenConsole.exe:
+# conpty.dll starts the one for Windows' own CPU, which differs from hc's
+# when x64 hc runs on an Arm PC. Windows' own ConPTY swallows the answers hc
+# gives programs (7501, DA), so hc ships this one. Pinned and checked.
+param([Parameter(Mandatory)][string]$Dest, [ValidateSet("x64", "arm64")][string]$Arch = $(if ($env:PROCESSOR_ARCHITECTURE -eq "ARM64") { "arm64" } else { "x64" }))
 $ErrorActionPreference = "Stop"
 $version = "1.24.260710001"
 $url = "https://github.com/microsoft/terminal/releases/download/v1.24.11911.0/Microsoft.Windows.Console.ConPTY.$version.nupkg"
