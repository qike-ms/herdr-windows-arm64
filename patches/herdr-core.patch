     if target != host || windows {
         build.arg(format!("-Dtarget={}", zig_target(&target)));
     }
+    println!("cargo:rerun-if-env-changed=HERDR_ZIG_LIBC_FILE");
+    if let Some(libc) = std::env::var_os("HERDR_ZIG_LIBC_FILE") {
+        build.arg("--libc").arg(libc);
+    }
     let status = build
         .arg("--prefix")
         .arg(out.join("zig-out"))
         .arg("--cache-dir")
         .arg(out.join("zig-cache"))
         .status()
-        .unwrap_or_else(|e| panic!("cannot run {zig:?} (Zig 0.16 required): {e}"));
+        .unwrap_or_else(|e| panic!("cannot run {zig:?} (Zig 0.17.1 required): {e}"));
     assert!(status.success(), "zig build of libghostty-vt failed: {status}");
 
     // Keep only the static archive in the search path so the linker can't pick
@@ -61,6 +65,20 @@ fn main() {
     std::fs::create_dir_all(&lib).unwrap();
     let name = if windows { "ghostty-vt-static.lib" } else { "libghostty-vt.a" };
     std::fs::copy(out.join("zig-out/lib").join(name), lib.join(name)).unwrap();
+    // Arm64 MSVC: Zig's bundled compiler runtime and Rust's compiler_builtins
+    // both define helpers like __udivti3 as weak externals with different
+    // defaults, which link.exe refuses (LNK1227). Rust's provide the same
+    // routines, so Zig's copy leaves the archive.
+    if target == "aarch64-pc-windows-msvc" {
+        let archive = lib.join(name);
+        let mut ar = Command::new(&zig);
+        ar.args(["ar", "d"]).arg(&archive).arg("compiler_rt.obj");
+        if let Some(path) = &clean_path {
+            ar.env("PATH", path);
+        }
